# ── Supabase (Project Settings → API) ─────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# anon / publishable key (safe for the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER ONLY. Needed to meter AI credits and to apply plans. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Gemini (server only) ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Optional; default gemini-3.8-flash
GEMINI_MODEL=gemini-3.8-flash

# ── Payment links (hosted by your payment provider; https URLs) ───
STARTER_PAYMENT_LINK=
PRO_PAYMENT_LINK=
# Secret for POST /api/billing/activate (operator applies a plan after payment is confirmed)
BILLING_ADMIN_SECRET=

# ── Public site details ───────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://salesintelai.digital
NEXT_PUBLIC_COMPANY_NAME=SalesIntel AI
NEXT_PUBLIC_CONTACT_EMAIL=hello@salesintelai.digital
